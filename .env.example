# Database
DATABASE_URL="postgresql://clinicos:clinicos_dev@localhost:5432/clinicos_dev"

# API
API_PORT=3001
API_HOST="0.0.0.0"

# Frontend
FRONTEND_URL="http://localhost:3000"
API_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# WhatsApp Cloud API. Generate a 32-byte random key and encode it in base64.
# This encrypts every clinic's individual access token before database storage.
WHATSAPP_TOKEN_ENCRYPTION_KEY=""
# Meta sends webhook verification and event signatures to this endpoint.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
# Runs the durable database worker every 30 seconds in the API process.
# Enable this in exactly one production instance.
WHATSAPP_WORKER_ENABLED="false"

# JWT
JWT_SECRET="dev_jwt_secret_change_in_production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="dev_refresh_secret_change_in_production"
JWT_REFRESH_EXPIRES_IN="7d"

# Environment
NODE_ENV="development"

# Application
APP_VERSION="0.0.1"

# Future: Storage
# STORAGE_TYPE="s3"
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# Future: Email/SMS
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
