# Database
DATABASE_URL="postgresql://clinicos:clinicos_dev@localhost:5432/clinicos_dev"

# API
API_PORT=3001
API_HOST="0.0.0.0"

# Frontend
FRONTEND_URL="http://localhost:3000"
API_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Google sign-in (create these in Google Auth Platform; never commit real values)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/v1/auth/google/callback"

# JWT
JWT_SECRET="dev_jwt_secret_change_in_production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="dev_refresh_secret_change_in_production"
JWT_REFRESH_EXPIRES_IN="7d"

# Environment
NODE_ENV="development"

# Required for encrypting WhatsApp access tokens at rest. Keep this stable across restarts.
WHATSAPP_ENCRYPTION_KEY="dev_whatsapp_encryption_key_change_me_32_chars"

# Application
APP_VERSION="0.0.1"

