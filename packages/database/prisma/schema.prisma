generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// MULTI-TENANT FOUNDATION
// ============================================================================

/// Organization is the root tenant entity. All data is isolated by organization.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("UTC")
  currency  String   @default("EGP")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  locations   Location[]
  departments Department[]
  users       User[]
  roles       Role[]
  patients    Patient[]
  services    Service[]
  appointments Appointment[]
  patientTags PatientTag[]
  whatsappConnection WhatsAppConnection?
  whatsappCampaigns WhatsAppCampaign[]
  whatsappMessages WhatsAppMessage[]

  @@map("organizations")
}

// ============================================================================
// PATIENTS
// ============================================================================

/// Patient is an organization-scoped clinical identity. It intentionally does
/// not belong to one location so a patient can receive care across the tenant.
model Patient {
  id                  String    @id @default(cuid())
  organizationId      String
  medicalRecordNumber String
  firstName           String
  lastName            String
  dateOfBirth         DateTime?
  gender              String?
  phone               String?
  email               String?
  address             String?
  emergencyContactName  String?
  emergencyContactPhone String?
  status              String    @default("active") // active | inactive
  customerType        String    @default("normal") // normal | regular | vip | new
  marketingConsent    Boolean   @default(false)
  marketingConsentAt  DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  tags         PatientTag[]
  campaignRecipients WhatsAppCampaignRecipient[]
  whatsappMessages WhatsAppMessage[]

  @@unique([organizationId, medicalRecordNumber])
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, phone])
  @@map("patients")
}

model Service {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("services")
}

model Appointment {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String
  serviceId      String?
  doctorId       String?
  scheduledAt    DateTime
  status         String   @default("booked") // booked | completed | missed | cancelled
  notes          String?
  reminderSentAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([organizationId, scheduledAt])
  @@index([patientId, scheduledAt])
  @@map("appointments")
}

model PatientTag {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, name])
  @@index([organizationId, name])
  @@map("patient_tags")
}

model WhatsAppConnection {
  id                   String   @id @default(cuid())
  organizationId       String   @unique
  phoneNumberId        String
  businessAccountId    String
  accessTokenCiphertext String
  apiVersion           String   @default("v21.0")
  appointmentTemplate  String?
  marketingTemplate    String?
  templateLanguage     String   @default("ar")
  reminderHoursBefore  Int      @default(24)
  remindersEnabled     Boolean  @default(false)
  isEnabled            Boolean  @default(false)
  lastError            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("whatsapp_connections")
}

model WhatsAppCampaign {
  id             String   @id @default(cuid())
  organizationId String
  createdById    String
  name           String
  templateName   String
  templateLanguage String @default("ar")
  audience       Json
  scheduledAt    DateTime?
  status         String   @default("draft") // draft | scheduled | sending | completed | failed | cancelled
  sentAt         DateTime?
  queueStartedAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipients   WhatsAppCampaignRecipient[]

  @@index([organizationId, status])
  @@map("whatsapp_campaigns")
}

model WhatsAppCampaignRecipient {
  id           String   @id @default(cuid())
  campaignId   String
  patientId    String
  phone        String
  status       String   @default("pending") // pending | sent | delivered | read | failed | skipped
  providerMessageId String?
  failureCode  String?
  attempts     Int      @default(0)
  lastError    String?
  nextAttemptAt DateTime?
  lockedAt     DateTime?
  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaign WhatsAppCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  patient  Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([campaignId, patientId])
  @@index([campaignId, status])
  @@map("whatsapp_campaign_recipients")
}

model WhatsAppMessage {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String?
  appointmentId  String?
  campaignRecipientId String?
  direction      String   // outbound | inbound
  providerMessageId String? @unique
  status         String   @default("pending")
  payload        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([organizationId, providerMessageId])
  @@map("whatsapp_messages")
}

// ============================================================================
// LOCATION / MULTI-LOCATION SUPPORT
// ============================================================================

/// Location represents a physical or virtual clinic site within an organization.
model Location {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  address        String
  phone          String
  email          String
  timezone       String
  status         String   @default("active") // active | inactive
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments  Department[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("locations")
}

// ============================================================================
// DEPARTMENTS / SPECIALTIES
// ============================================================================

/// Department represents a specialty unit or functional department within a location.
model Department {
  id               String   @id @default(cuid())
  organizationId   String
  locationId       String
  name             String
  specialtyModule  String   @default("general") // general | dentistry | dermatology | etc.
  status           String   @default("active")  // active | inactive
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, locationId, id])
  @@index([organizationId, locationId])
  @@map("departments")
}

// ============================================================================
// USERS / ROLES / PERMISSIONS
// ============================================================================

/// User represents any person interacting with the system.
model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  passwordHash   String
  firstName      String
  lastName       String
  role           String   @default("receptionist") // owner | admin | doctor | receptionist | nurse | accountant | custom
  status         String   @default("active")       // active | inactive | suspended
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles    UserRole[]

  @@unique([organizationId, email])
  @@index([organizationId, email])
  @@map("users")
}

/// Role represents a set of permissions.
model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isBuiltIn      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions     RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

/// Permission represents an atomic action that can be authorized.
/// Examples: patient:read, patient:create, billing:read, billing:create
model Permission {
  id        String   @id @default(cuid())
  code      String   @unique // e.g., "patient:read", "billing:create"
  category  String   // e.g., "patient", "billing", "user", "admin"
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  roles RolePermission[]

  @@index([category])
  @@map("permissions")
}

/// RolePermission is the join table between Role and Permission.
model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  // Relationships
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId, permissionId])
  @@map("role_permissions")
}

/// UserRole is the join table between User and Role.
model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId, roleId])
  @@map("user_roles")
}
