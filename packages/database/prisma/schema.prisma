generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// MULTI-TENANT FOUNDATION
// ============================================================================

/// Organization is the root tenant entity. All data is isolated by organization.
model Organization {
  id                    String    @id @default(cuid())
  name                  String
  slug                  String    @unique
  facilityType          String    @default("CLINIC") // CLINIC | HOSPITAL | CENTER | RADIOLOGY_CENTER
  specialty             String    @default("GENERAL")
  timezone              String    @default("UTC")
  currency              String    @default("EGP")
  subscriptionPlan      String    @default("trial") // trial | clinic | center | enterprise
  subscriptionStatus    String    @default("trial") // trial | active | suspended | expired
  trialEndsAt           DateTime?
  subscriptionEndsAt    DateTime?
  prescriptionHeader    String?
  prescriptionSubheader String?
  prescriptionPhone     String?
  prescriptionAddress   String?
  prescriptionLogoUrl   String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relationships
  locations                Location[]
  departments              Department[]
  users                    User[]
  roles                    Role[]
  patients                 Patient[]
  services                 Service[]
  clinicalRecords          ClinicalRecord[]
  appointments             Appointment[]
  visits                   Visit[]
  marketingCampaigns       MarketingCampaign[]
  auditLogs                AuditLog[]
  oauthLoginCodes          OAuthLoginCode[]
  subscriptions            Subscription[]
  payments                 Payment[]
  subscriptionEvents       SubscriptionEvent[]
  messagingQuotaViolations MessagingQuotaViolation[]
  whatsappMessages         WhatsAppMessage[]
  whatsappIntegration      WhatsAppIntegration?

  @@map("organizations")
}

// ============================================================================
// SAAS BILLING / ENTITLEMENTS
// ============================================================================

enum SubscriptionPlan {
  FREE_TRIAL
  STARTER
  PROFESSIONAL
  CLINIC
  CENTER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  REJECTED
  REFUNDED
}

/// One current subscription is maintained per tenant. Historical changes are
/// retained as SubscriptionEvent records, so billing can evolve without
/// exposing sensitive payment information to clinic users.
model AuthLoginFailure {
  id        String   @id @default(cuid())
  keyHash   String
  createdAt DateTime @default(now())

  @@index([keyHash, createdAt])
  @@map("auth_login_failures")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String
  plan               SubscriptionPlan   @default(FREE_TRIAL)
  status             SubscriptionStatus @default(TRIALING)
  trialStartedAt     DateTime?
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt         DateTime?
  isCurrent          Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments     Payment[]
  events       SubscriptionEvent[]

  @@index([organizationId, isCurrent])
  @@index([organizationId, status])
  @@map("subscriptions")
}

model Payment {
  id              String        @id @default(cuid())
  organizationId  String
  subscriptionId  String
  amount          Int
  currency        String        @default("EGP")
  paymentMethod   String        @default("manual_transfer")
  reference       String
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([subscriptionId, status])
  @@map("payments")
}

model SubscriptionEvent {
  id             String   @id @default(cuid())
  organizationId String
  subscriptionId String
  actorId        String?
  action         String
  summary        String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  actor        User?        @relation("SubscriptionEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([subscriptionId, createdAt])
  @@map("subscription_events")
}

// ============================================================================
// PATIENTS
// ============================================================================

/// Patient is an organization-scoped clinical identity. It intentionally does
/// not belong to one location so a patient can receive care across the tenant.
model Patient {
  id                       String    @id @default(cuid())
  organizationId           String
  medicalRecordNumber      String
  firstName                String
  lastName                 String
  dateOfBirth              DateTime?
  admittedAt               DateTime  @default(now())
  gender                   String?
  maritalStatus            String?
  phone                    String?
  whatsappPhone            String?
  whatsappOptIn            Boolean   @default(false)
  whatsappOptInAt          DateTime?
  whatsappMarketingOptIn   Boolean   @default(false)
  whatsappMarketingOptInAt DateTime?
  occupation               String?
  city                     String?
  governorate              String?
  leadSource               String?
  marketingConsent         Boolean   @default(false)
  marketingConsentAt       DateTime?
  email                    String?
  address                  String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  status                   String    @default("active") // active | inactive
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  organization                Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinicalRecords             ClinicalRecord[]
  appointments                Appointment[]
  visits                      Visit[]
  marketingCampaignRecipients MarketingCampaignRecipient[]
  whatsappMessages            WhatsAppMessage[]

  @@unique([organizationId, medicalRecordNumber])
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, phone])
  @@index([organizationId, admittedAt])
  @@map("patients")
}

// ============================================================================
// WHATSAPP MARKETING CAMPAIGNS
// ============================================================================

model MarketingCampaign {
  id             String    @id @default(cuid())
  organizationId String
  serviceId      String?
  templateName   String
  offerText      String
  expiresAt      DateTime?
  status         String    @default("DRAFT") // DRAFT | SENDING | COMPLETED | FAILED
  createdById    String
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service?                     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdBy    User                         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  recipients   MarketingCampaignRecipient[]

  @@index([organizationId, status, createdAt])
  @@index([organizationId, createdAt])
  @@map("marketing_campaigns")
}

model MarketingCampaignRecipient {
  id                String    @id @default(cuid())
  campaignId        String
  patientId         String
  dedupeKey         String    @unique
  status            String    @default("PENDING") // PENDING | SENT | FAILED | SKIPPED
  providerMessageId String?
  failureReason     String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  campaign         MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  whatsappMessages WhatsAppMessage[]

  @@unique([campaignId, patientId])
  @@index([campaignId, status])
  @@index([patientId, createdAt])
  @@map("marketing_campaign_recipients")
}

model WhatsAppIntegration {
  id                       String       @id @default(cuid())
  organizationId           String       @unique
  phoneNumberId            String       @unique
  wabaId                   String
  accessTokenCiphertext    String
  accessTokenIv            String
  accessTokenAuthTag       String
  apiVersion               String       @default("v26.0")
  appointmentTemplate      String
  marketingTemplate        String?
  templateLanguage         String       @default("ar")
  enabled                  Boolean      @default(false)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([enabled])
  @@map("whatsapp_integrations")
}

model WhatsAppMessage {
  id                  String    @id @default(cuid())
  organizationId      String
  patientId           String
  appointmentId       String?
  campaignRecipientId String?
  category            String // utility | marketing
  status              String    @default("QUEUED") // QUEUED | SENT | DELIVERED | READ | FAILED | SKIPPED
  templateName        String
  providerMessageId   String?   @unique
  failureReason       String?
  sentAt              DateTime?
  deliveredAt         DateTime?
  readAt              DateTime?
  failedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization      Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient           Patient                     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment       Appointment?                @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  campaignRecipient MarketingCampaignRecipient? @relation(fields: [campaignRecipientId], references: [id], onDelete: SetNull)

  @@index([organizationId, category, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([patientId, createdAt])
  @@map("whatsapp_messages")
}

model MessagingQuotaViolation {
  id             String    @id @default(cuid())
  organizationId String
  actorId        String?
  channel        String // utility | marketing
  reason         String
  attemptedCount Int       @default(1)
  blockedUntil   DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, channel, createdAt])
  @@index([organizationId, actorId, createdAt])
  @@index([blockedUntil])
  @@map("messaging_quota_violations")
}

// ============================================================================
// CLINIC SERVICES
// ============================================================================

model Service {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  specialty      String
  durationMinutes Int         @default(30)
  price          Int?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  marketingCampaigns MarketingCampaign[]

  @@unique([organizationId, name])
  @@index([organizationId, specialty, isActive])
  @@map("services")
}

// ============================================================================
// APPOINTMENTS
// ============================================================================

model Appointment {
  id              String   @id @default(cuid())
  organizationId  String
  patientId       String
  createdById     String
  serviceId       String?
  doctorId        String?
  scheduledAt     DateTime
  durationMinutes Int      @default(30)
  status          String   @default("scheduled") // scheduled | confirmed | checked_in | completed | cancelled | no_show
  reason          String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization              Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient                   Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  service                   Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdBy                 User              @relation("AppointmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  doctor                    User?             @relation("AppointmentDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  visit                     Visit?
  whatsappReminderSentAt    DateTime?
  whatsappReminderMessageId String?
  whatsappMessages          WhatsAppMessage[]

  @@index([organizationId, scheduledAt])
  @@index([organizationId, patientId])
  @@map("appointments")
}

// ============================================================================
// VISITS
// ============================================================================

/// A visit is the operational encounter created when a patient checks in.
model Visit {
  id             String    @id @default(cuid())
  organizationId String
  appointmentId  String    @unique
  patientId      String
  doctorId       String?
  createdById    String
  status         String    @default("in_progress") // in_progress | completed | cancelled
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor       User?        @relation("VisitDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("VisitCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, patientId, startedAt])
  @@index([organizationId, status])
  @@map("visits")
}

// ============================================================================
// CLINICAL RECORDS
// ============================================================================

/// An organization-scoped entry in a patient's longitudinal clinical history.
/// Authoring information is retained for clinical accountability.
model ClinicalRecord {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String
  authorId       String
  category       String
  content        String
  symptoms       String?
  diagnosis      String?
  treatmentPlan  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  author       User         @relation("ClinicalRecordAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([organizationId, patientId, createdAt])
  @@index([organizationId, id])
  @@map("clinical_records")
}

// ============================================================================
// LOCATION / MULTI-LOCATION SUPPORT
// ============================================================================

/// Location represents a physical or virtual clinic site within an organization.
model Location {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  address        String
  phone          String
  email          String
  timezone       String
  status         String   @default("active") // active | inactive
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments  Department[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("locations")
}

// ============================================================================
// DEPARTMENTS / SPECIALTIES
// ============================================================================

/// Department represents a specialty unit or functional department within a location.
model Department {
  id              String   @id @default(cuid())
  organizationId  String
  locationId      String
  name            String
  specialtyModule String   @default("general") // general | dentistry | dermatology | etc.
  status          String   @default("active") // active | inactive
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, locationId, id])
  @@index([organizationId, locationId])
  @@map("departments")
}

// ============================================================================
// USERS / ROLES / PERMISSIONS
// ============================================================================

/// User represents any person interacting with the system.
model User {
  id              String    @id @default(cuid())
  organizationId  String
  email           String
  passwordHash    String
  firstName       String
  lastName        String
  role            String    @default("receptionist") // owner | admin | doctor | receptionist | nurse | accountant | custom
  status          String    @default("active") // active | inactive | suspended
  isPlatformAdmin Boolean   @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relationships
  organization              Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles                 UserRole[]
  authoredClinicalRecords   ClinicalRecord[]          @relation("ClinicalRecordAuthor")
  createdAppointments       Appointment[]             @relation("AppointmentCreator")
  assignedAppointments      Appointment[]             @relation("AppointmentDoctor")
  doctorVisits              Visit[]                   @relation("VisitDoctor")
  createdVisits             Visit[]                   @relation("VisitCreator")
  auditLogs                 AuditLog[]                @relation("AuditActor")
  oauthLoginCodes           OAuthLoginCode[]
  passwordResetTokens       PasswordResetToken[]
  reviewedPayments          Payment[]                 @relation("PaymentReviewer")
  subscriptionEvents        SubscriptionEvent[]       @relation("SubscriptionEventActor")
  createdMarketingCampaigns MarketingCampaign[]
  messagingQuotaViolations  MessagingQuotaViolation[]

  @@unique([organizationId, email])
  @@index([organizationId, email])
  @@map("users")
}

/// A short-lived, single-use code issued after a successful external OAuth
/// callback. It lets the browser obtain a normal Clinico session without
/// exposing a JWT in the redirect URL.
model OAuthLoginCode {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  codeHash       String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, expiresAt])
  @@index([userId, expiresAt])
  @@map("oauth_login_codes")
}

// Immutable organization-scoped audit trail. Metadata must never contain
// clinical notes, passwords, or full patient contact details.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  summary        String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}

/// Role represents a set of permissions.
model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isBuiltIn      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  userRoles    UserRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

/// Permission represents an atomic action that can be authorized.
/// Examples: patient:read, patient:create, billing:read, billing:create
model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // e.g., "patient:read", "billing:create"
  category    String // e.g., "patient", "billing", "user", "admin"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  roles RolePermission[]

  @@index([category])
  @@map("permissions")
}

/// RolePermission is the join table between Role and Permission.
model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  // Relationships
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId, permissionId])
  @@map("role_permissions")
}

/// UserRole is the join table between User and Role.
model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId, roleId])
  @@map("user_roles")
}
