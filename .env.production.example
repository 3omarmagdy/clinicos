# Never commit a real production .env file.
# DATABASE_URL comes from your hosted PostgreSQL provider (for example Neon).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Your deployed Vercel URL, with no trailing slash.
FRONTEND_URL="https://your-project.vercel.app"

# Use long random values in the hosting dashboard, never the development secrets.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-second-long-random-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
NODE_ENV="production"

# Required for encrypting WhatsApp access tokens at rest. Generate a long random value
# and keep it stable across deploys; never commit the real value.
WHATSAPP_ENCRYPTION_KEY="replace-with-a-stable-random-secret-at-least-32-characters"

# Optional Meta Embedded Signup configuration.
META_WHATSAPP_EMBEDDED_SIGNUP_ENABLED="false"
META_APP_ID=""
META_APP_SECRET=""
META_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=""
WHATSAPP_API_VERSION="v26.0"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="replace-with-a-random-webhook-token"
